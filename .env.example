DATABASE_URL=
DIRECT_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=4000
NODE_ENV=development
# Leave unset until the custom domain + managed cert are live for this env.
# Set to ".ukssu.in" only once requests actually arrive via a *.ukssu.in hostname —
# otherwise the browser will reject the Set-Cookie entirely (domain mismatch).
COOKIE_DOMAIN=
