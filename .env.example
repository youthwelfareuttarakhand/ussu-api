DATABASE_URL=
DIRECT_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=4000
NODE_ENV=development
# Leave unset until the custom domain + managed cert are live for this env.
# Set to ".ukssu.ac.in" only once requests actually arrive via a *.ukssu.ac.in hostname —
# otherwise the browser will reject the Set-Cookie entirely (domain mismatch).
COOKIE_DOMAIN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Intentionally PRODUCTION-ONLY — set on the live ussu-api Container App,
# never in staging or local dev. Leaving these unset here is deliberate:
# document uploads fail with a clear "storage not configured" error in any
# environment other than production, so staging/dev traffic can never write
# real applicant documents into the prod Azure Storage account.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
